{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			],
			"@engine/*": [
				"src/lib/engine/*"
			]
		},
		"verbatimModuleSyntax": true,
		"types": [
			"vitest/globals"
		]
	},
	"include": [
		"src",
		"tests",
		".astro/types.d.ts",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist"
	]
}
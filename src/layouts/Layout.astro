---
import '../styles/global.css';
import Seo from '../components/site/Seo.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import CookieConsent from '../components/site/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Full-bleed layout with no marketing header/footer (the simulator app). */
  bare?: boolean;
}
const { bare = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RHDVK7JCBX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RHDVK7JCBX');
    </script>
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3958657111201741"
     crossorigin="anonymous"></script>
    <meta name="google-adsense-account" content="ca-pub-3958657111201741" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...seo} />
  </head>
  <body class:list={[bare && 'overflow-hidden']}>
    {bare ? (
      <slot />
    ) : (
      <>
        <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
        <Header />
        <main id="main">
          <slot />
        </main>
        <Footer />
      </>
    )}
    <CookieConsent />
  </body>
</html>

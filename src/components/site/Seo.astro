---
/**
 * Centralised <head> SEO: canonical, description, Open Graph, Twitter card and
 * optional JSON-LD blocks. Every page passes a title/description; structured
 * data (SoftwareApplication, FAQ, Breadcrumb, Article) is opt-in per page.
 */
const SITE = 'https://circuitsimlab.com';
const NAME = 'CircuitSimLab';

interface Props {
  title: string;
  description: string;
  path?: string; // absolute path, e.g. "/simulator"
  noindex?: boolean;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  path = new URL(Astro.request.url).pathname,
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const canonical = SITE + (path === '/' ? '/' : path.replace(/\/$/, ''));
// Append the brand once, and only when the result still fits in a search
// result title (~62 characters) — a long descriptive title beats a cut-off one.
const branded = `${title} | ${NAME}`;
const fullTitle = title.includes(NAME) || branded.length > 62 ? title : branded;
const ogImage = `${SITE}/og-default.jpg`;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Site-wide entity data, emitted once on the home page.
const siteBlocks =
  path === '/'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: NAME,
          alternateName: 'Circuit Sim Lab',
          url: `${SITE}/`,
        },
        {
          '@context': 'https://schema.org',
          '@type': 'Organization',
          name: NAME,
          url: `${SITE}/`,
          logo: `${SITE}/apple-touch-icon.png`,
        },
      ]
    : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? (
  <meta name="robots" content="noindex,nofollow" />
) : (
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
)}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="CircuitSimLab — free online circuit simulator" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{[...siteBlocks, ...blocks].map((b) => (
  <script type="application/ld+json" set:html={JSON.stringify(b)} />
))}

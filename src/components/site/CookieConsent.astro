---
/**
 * Cookie consent banner for Google AdSense & Analytics compliance.
 * Shows on first visit, stores the choice in localStorage and reports it to
 * Google tags through Consent Mode v2 (defaults are set in Layout.astro).
 * Required by GDPR & Google AdSense policies.
 */
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-line bg-paper/98 backdrop-blur-md shadow-lg"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="container-page flex flex-col sm:flex-row items-start sm:items-center gap-3 py-3 sm:py-4">
    <div class="flex-1 min-w-0">
      <p class="text-sm text-ink-2 leading-relaxed">
        We use cookies for analytics (Google Analytics) and advertising (Google AdSense) to keep this
        tool free. Accept to allow them, or reject to browse without analytics and personalised-ad
        cookies. You can change your mind any time from the footer.
        <a href="/privacy" class="text-accent hover:underline font-medium">Learn more</a>
      </p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <button
        id="cookie-reject"
        type="button"
        class="btn btn-ghost text-xs sm:text-sm px-3 py-1.5"
      >
        Reject
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="btn btn-primary text-xs sm:text-sm px-4 py-1.5"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'csl_cookie_consent';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  function hideBanner() {
    if (banner) banner.classList.add('hidden');
  }

  function showBanner() {
    if (banner) banner.classList.remove('hidden');
  }

  // Check if consent was already given
  let consent: string | null = null;
  try { consent = localStorage.getItem(CONSENT_KEY); } catch { /* private mode */ }
  if (!consent) {
    showBanner();
  }

  // Tell Google tags about the choice (Consent Mode v2) and remember it.
  function choose(value: 'accepted' | 'rejected') {
    try { localStorage.setItem(CONSENT_KEY, value); } catch { /* private mode */ }
    const v = value === 'accepted' ? 'granted' : 'denied';
    const w = window as unknown as { gtag?: (...a: unknown[]) => void };
    w.gtag?.('consent', 'update', {
      ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v,
    });
    hideBanner();
  }

  acceptBtn?.addEventListener('click', () => choose('accepted'));
  rejectBtn?.addEventListener('click', () => choose('rejected'));

  // "Cookie settings" links (footer) reopen the banner.
  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); showBanner(); }),
  );
</script>

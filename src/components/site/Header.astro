---
import Logo from './Logo.astro';

const nav = [
  { href: '/simulator', label: 'Simulator' },
  { href: '/examples', label: 'Examples' },
  { href: '/components', label: 'Components' },
  { href: '/learn', label: 'Learn' },
  { href: '/documentation', label: 'Docs' },
  { href: '/pricing', label: 'Pricing' },
];
const current = new URL(Astro.request.url).pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-md">
  <div class="container-page flex h-14 items-center justify-between gap-2 sm:gap-4">
    <a href="/" class="flex items-center shrink-0" aria-label="CircuitSimulate home">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {nav.map((n) => (
        <a
          href={n.href}
          aria-current={isActive(n.href) ? 'page' : undefined}
          class:list={[
            'px-3 py-2 text-sm rounded transition-colors',
            isActive(n.href) ? 'text-accent font-semibold bg-accent-soft/40' : 'text-ink-2 hover:text-ink hover:bg-surface',
          ]}
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/simulator" class="btn btn-primary text-xs sm:text-sm px-2.5 sm:px-3.5 py-1.5 sm:py-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span>Open Simulator</span>
      </a>

      <details class="md:hidden relative group">
        <summary class="btn btn-ghost p-0 min-h-0 h-9 w-9 justify-center list-none cursor-pointer" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-open:hidden">
            <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden group-open:block">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </summary>
        <div class="fixed inset-x-3 top-16 z-50 rounded-xl border border-line bg-paper/98 p-3 shadow-2xl backdrop-blur-md animate-[menu-in_0.15s_ease-out]">
          <div class="grid grid-cols-2 gap-1.5 pb-2 border-b border-line">
            {nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
                  isActive(n.href) ? 'bg-accent-soft text-accent font-semibold' : 'text-ink-2 hover:bg-surface hover:text-ink'
                ]}
              >
                {n.label}
              </a>
            ))}
          </div>
          <div class="pt-2">
            <a href="/simulator" class="btn btn-primary w-full justify-center text-sm py-2.5">
              Launch Simulator
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

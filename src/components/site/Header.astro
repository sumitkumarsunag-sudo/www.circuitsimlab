---
import Logo from './Logo.astro';

const nav = [
  { href: '/simulator', label: 'Simulator' },
  { href: '/examples', label: 'Examples' },
  { href: '/components', label: 'Components' },
  { href: '/learn', label: 'Learn' },
  { href: '/documentation', label: 'Docs' },
  { href: '/pricing', label: 'Pricing' },
];
const current = new URL(Astro.request.url).pathname;
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-sm">
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="CircuitSimulate home">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {nav.map((n) => (
        <a
          href={n.href}
          aria-current={isActive(n.href) ? 'page' : undefined}
          class:list={[
            'px-3 py-2 text-sm rounded transition-colors',
            isActive(n.href) ? 'text-accent font-medium' : 'text-ink-2 hover:text-ink hover:bg-surface',
          ]}
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/simulator" class="btn btn-primary hidden sm:inline-flex">Open Simulator</a>

      <details class="md:hidden relative">
        <summary class="btn btn-ghost list-none" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded border border-line bg-paper shadow-lg py-1">
          {nav.map((n) => (
            <a href={n.href} class="block px-4 py-2 text-sm text-ink-2 hover:bg-surface hover:text-ink">{n.label}</a>
          ))}
          <a href="/simulator" class="block px-4 py-2 text-sm font-medium text-accent hover:bg-surface">Open Simulator</a>
        </div>
      </details>
    </div>
  </div>
</header>

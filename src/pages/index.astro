---
import Layout from '../layouts/Layout.astro';
import { allComponents } from '../lib/components/registry.ts';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CircuitSimulate',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Free online circuit simulator with real DC, transient and AC analysis. Build schematics in the browser and see current flow, node voltages and waveforms.',
};

const partCount = allComponents().length;

const features = [
  {
    t: 'Real analysis, not a demo',
    d: 'A modified-nodal-analysis solver runs DC operating point, transient and AC sweeps — the same math SPICE uses. Every number on screen is solved, never faked.',
  },
  {
    t: 'See the electricity',
    d: 'Current animates along the wires it actually flows through. Nodes are coloured by solved voltage, LEDs light by real forward current.',
  },
  {
    t: 'Built for the browser',
    d: 'Static pages, one interactive island, solver in a Web Worker. It loads fast, works offline after first visit, and never uploads your circuit.',
  },
  {
    t: 'Measure like the bench',
    d: 'Drop a multimeter or a two-channel oscilloscope onto the canvas and read volts, amps and waveforms with real time/div and volt/div.',
  },
];
---

<Layout
  title="CircuitSimulate — Build. Simulate. Understand."
  description="Free online circuit simulator with real DC, transient and AC analysis. Drag components onto the canvas, wire them up, and watch current flow — right in your browser."
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute inset-0 grid-paper grid-paper-fade opacity-60" aria-hidden="true"></div>
    <div class="container-page relative grid gap-10 py-16 md:grid-cols-2 md:py-24 md:gap-8 items-center">
      <div>
        <p class="tnum text-xs uppercase tracking-[0.2em] text-accent">Online circuit simulator</p>
        <h1 class="mt-3 text-4xl font-semibold leading-[1.05] tracking-tight md:text-6xl">
          Build. Simulate.<br /><span class="text-accent">Understand.</span>
        </h1>
        <p class="mt-5 max-w-md text-lg text-ink-2">
          Draw a schematic, press run, and watch real current move through it. A precise electronics
          lab that lives in a browser tab — free, no sign-up, nothing to install.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/simulator" class="btn btn-primary text-base">Open the simulator</a>
          <a href="/examples" class="btn btn-ghost text-base">Browse examples</a>
        </div>
        <dl class="mt-9 flex gap-8">
          <div>
            <dt class="text-xs text-muted">Components</dt>
            <dd class="tnum text-2xl font-semibold">{partCount}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">Analyses</dt>
            <dd class="tnum text-2xl font-semibold">DC · Tran · AC</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">Price</dt>
            <dd class="tnum text-2xl font-semibold">$0</dd>
          </div>
        </dl>
      </div>

      <!-- Live-looking schematic: a battery → resistor → LED loop with animated flow. -->
      <div class="relative">
        <div class="rounded-lg border border-line bg-paper shadow-sm">
          <div class="flex items-center gap-1.5 border-b border-line px-3 py-2">
            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
            <span class="tnum ml-2 text-xs text-muted">led-blinker.circuit</span>
            <span class="tnum ml-auto text-xs text-ok">● running</span>
          </div>
          <svg viewBox="0 0 360 240" class="w-full" role="img" aria-label="Animated LED circuit">
            <!-- wire loop -->
            <g stroke="var(--color-ink)" stroke-width="2" fill="none" stroke-linecap="round">
              <path d="M80 60 H280" />
              <path d="M280 60 V180" />
              <path d="M280 180 H80" />
              <path d="M80 180 V60" />
            </g>
            <!-- animated current -->
            <g stroke="var(--color-signal)" stroke-width="2.5" fill="none" stroke-linecap="round" class="flow">
              <path d="M80 60 H280" /><path d="M280 60 V180" /><path d="M280 180 H80" /><path d="M80 180 V60" />
            </g>
            <!-- battery -->
            <g stroke="var(--color-ink)" stroke-width="2" transform="translate(80 120)">
              <line x1="0" y1="-14" x2="0" y2="14" stroke-width="3" />
              <line x1="-8" y1="-8" x2="-8" y2="8" />
              <rect x="-14" y="-22" width="28" height="44" fill="var(--color-paper)" stroke="none" opacity="0" />
            </g>
            <text x="58" y="124" class="tnum" font-size="11" fill="var(--color-muted)">9V</text>
            <!-- resistor (top) -->
            <g transform="translate(180 60)" stroke="var(--color-ink)" stroke-width="2" fill="none">
              <path d="M-30 0 h8 l4 -8 l8 16 l8 -16 l8 16 l4 -8 h8" />
            </g>
            <text x="180" y="44" text-anchor="middle" class="tnum" font-size="11" fill="var(--color-muted)">330Ω</text>
            <!-- LED (right) -->
            <g transform="translate(280 120)" stroke="var(--color-pos)" stroke-width="2" fill="none">
              <polygon points="-10,-10 -10,10 8,0" fill="var(--color-signal)" fill-opacity="0.5" />
              <line x1="8" y1="-10" x2="8" y2="10" />
              <line x1="14" y1="-14" x2="20" y2="-20" /><line x1="10" y1="-16" x2="16" y2="-22" />
            </g>
            <!-- node voltage tags -->
            <circle cx="80" cy="60" r="3" fill="var(--color-pos)" />
            <text x="86" y="54" class="tnum" font-size="10" fill="var(--color-pos)">9.00 V</text>
            <circle cx="280" cy="60" r="3" fill="var(--color-neg)" />
            <text x="230" y="54" class="tnum" font-size="10" fill="var(--color-neg)">2.10 V</text>
            <text x="230" y="205" class="tnum" font-size="10" fill="var(--color-signal)">20.9 mA</text>
          </svg>
        </div>
        <p class="mt-2 text-center text-xs text-muted">A solved loop — voltages and current are what the analysis returns.</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="container-page py-16 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Not a picture of a simulator — a simulator.</h2>
    <p class="mt-3 max-w-2xl text-ink-2">Plenty of tools animate a cartoon. CircuitSimulate solves the circuit and draws the answer.</p>
    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {features.map((f) => (
        <div class="border-t border-line pt-4">
          <h3 class="font-semibold">{f.t}</h3>
          <p class="mt-1.5 text-sm text-ink-2">{f.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Workflow -->
  <section class="border-y border-line bg-surface">
    <div class="container-page py-16 md:py-20">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Four steps to a working circuit</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Place', 'Drag parts from the palette onto a snapping grid.'],
          ['Wire', 'Click terminal to terminal — wires route orthogonally and snap to pins.'],
          ['Run', 'Pick DC, transient or AC. The solver runs in a background worker.'],
          ['Read', 'Watch current flow, read node voltages, or scope a waveform.'],
        ].map(([t, d], i) => (
          <li class="rounded-md border border-line bg-paper p-5">
            <span class="tnum text-sm text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-semibold">{t}</h3>
            <p class="mt-1 text-sm text-ink-2">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-16 text-center md:py-24">
    <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Open a blank canvas.</h2>
    <p class="mx-auto mt-3 max-w-md text-ink-2">No account, no download. Your circuit stays in your browser until you choose to share it.</p>
    <a href="/simulator" class="btn btn-primary mt-6 text-base">Launch CircuitSimulate</a>
  </section>
</Layout>

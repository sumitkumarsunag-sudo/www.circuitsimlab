---
import Layout from '../../layouts/Layout.astro';
import { TOOLS } from '../../lib/content/tools.ts';

// Group by category, preserving first-seen order.
const cats: string[] = [];
for (const t of TOOLS) if (!cats.includes(t.category)) cats.push(t.category);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'CircuitSimulate calculators',
  itemListElement: TOOLS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.title,
    url: `https://circuitsimlab.com/tools/${t.slug}`,
  })),
};
---

<Layout
  title="Electronics calculators — Ohm's law, LED resistor, RC, 555 timer"
  description="Free browser calculators for everyday electronics: Ohm's law, voltage divider, LED series resistor, RC time constant, resistor colour code and 555 timer. Instant, no sign-up."
  path="/tools"
  jsonLd={jsonLd}
>
  <div class="container-page py-12 md:py-16">
    <p class="tnum text-xs uppercase tracking-[0.2em] text-accent">Calculators</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">Electronics calculators</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      Small, focused calculators for the arithmetic that comes up while you design. Each one runs
      entirely in your browser and updates as you type — and every one has a matching circuit you can
      open in the <a href="/simulator" class="prose-link">simulator</a> to check the answer for real.
    </p>

    {cats.map((cat) => (
      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-faint">{cat}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {TOOLS.filter((t) => t.category === cat).map((t) => (
            <a
              href={`/tools/${t.slug}`}
              class="group flex flex-col rounded-lg border border-line bg-paper p-5 transition-colors hover:border-accent"
            >
              <h3 class="font-semibold group-hover:text-accent">{t.title}</h3>
              <p class="mt-1.5 flex-1 text-sm text-ink-2">{t.summary}</p>
              <span class="tnum mt-4 text-xs text-accent">Open calculator →</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

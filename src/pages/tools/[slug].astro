---
import Layout from '../../layouts/Layout.astro';
import { TOOLS, getTool } from '../../lib/content/tools.ts';

export function getStaticPaths() {
  return TOOLS.map((t) => ({ params: { slug: t.slug }, props: { slug: t.slug } }));
}

const { slug } = Astro.props as { slug: string };
const tool = getTool(slug)!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.title,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  description: tool.summary,
  url: `https://circuitsimulate.com/tools/${tool.slug}`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isPartOf: { '@type': 'WebSite', name: 'CircuitSimulate', url: 'https://circuitsimulate.com' },
};
---

<Layout
  title={`${tool.title} — free online calculator`}
  description={tool.summary}
  path={`/tools/${tool.slug}`}
  jsonLd={jsonLd}
>
  <div class="container-page py-12 md:py-16">
    <nav class="tnum text-xs text-muted" aria-label="Breadcrumb">
      <a href="/tools" class="hover:text-accent">Calculators</a> <span class="mx-1">/</span> {tool.category}
    </nav>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">{tool.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-2">{tool.intro}</p>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
      <!-- Inputs -->
      <form class="rounded-lg border border-line bg-paper p-5" data-tool={tool.slug} novalidate>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-faint">Inputs</h2>
        <div class="mt-4 space-y-4">
          {tool.fields.map((f) => (
            <div>
              <label for={f.id} class="block text-sm font-medium text-ink">{f.label}</label>
              <div class="mt-1.5 flex items-stretch">
                {f.type === 'select' ? (
                  <select
                    id={f.id}
                    name={f.id}
                    class="tnum w-full rounded border border-line-strong bg-surface px-2.5 py-2 text-sm text-ink focus:border-accent"
                  >
                    {f.options!.map((o) => (
                      <option value={o.value} selected={String(f.default) === o.value}>{o.label}</option>
                    ))}
                  </select>
                ) : (
                  <>
                    <input
                      id={f.id}
                      name={f.id}
                      type="number"
                      inputmode="decimal"
                      step={f.step ?? 'any'}
                      min={f.min}
                      value={f.default ?? ''}
                      placeholder={f.placeholder ?? ''}
                      class="tnum w-full rounded-l border border-line-strong bg-paper px-2.5 py-2 text-sm text-ink focus:border-accent"
                      aria-describedby={f.hint ? `${f.id}-hint` : undefined}
                    />
                    {f.unit && (
                      <span class="tnum inline-flex items-center rounded-r border border-l-0 border-line-strong bg-surface px-2.5 text-sm text-muted">
                        {f.unit}
                      </span>
                    )}
                  </>
                )}
              </div>
              {f.hint && <p id={`${f.id}-hint`} class="mt-1 text-xs text-muted">{f.hint}</p>}
            </div>
          ))}
        </div>
      </form>

      <!-- Outputs + formula -->
      <div>
        <div class="rounded-lg border border-line bg-surface p-5">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-faint">Results</h2>
          <dl class="mt-3 space-y-2">
            {tool.outputs.map((o) => (
              <div class:list={[
                'flex items-baseline justify-between gap-4 border-b border-line/60 pb-2',
                o.primary && 'border-line-strong',
              ]}>
                <dt class:list={['text-sm', o.primary ? 'font-medium text-ink' : 'text-ink-2']}>{o.label}</dt>
                <dd
                  id={o.id}
                  class:list={['tnum', o.primary ? 'text-lg font-semibold text-accent' : 'text-sm font-medium']}
                >—</dd>
              </div>
            ))}
          </dl>
          <p id="tool-note" class="mt-3 text-xs text-muted">Results update as you type.</p>
        </div>

        <div class="mt-6 rounded-lg border border-line bg-paper p-5">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-faint">Formula</h2>
          <div class="tnum mt-3 space-y-1.5 text-sm text-ink-2">
            {tool.formula.map((line) => <p>{line}</p>)}
          </div>
        </div>
      </div>
    </div>

    <div class="doc mt-10 max-w-2xl">
      <h2>How it works</h2>
      {tool.explain.map((p) => <p>{p}</p>)}
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/simulator" class="btn btn-primary">Open the simulator →</a>
      {tool.related.map((r) => (
        <a href={r.href} class="btn btn-ghost">{r.label}</a>
      ))}
    </div>
  </div>

  <script>
    const form = document.querySelector('form[data-tool]') as HTMLFormElement | null;
    if (form) {
      const tool = form.dataset.tool!;
      const note = document.getElementById('tool-note');

      // Read a numeric input; returns NaN if empty/invalid.
      const num = (id: string): number => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (!el || el.value.trim() === '') return NaN;
        return Number(el.value);
      };
      const sel = (id: string): number => Number((document.getElementById(id) as HTMLSelectElement).value);
      const set = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      const dash = (...ids: string[]) => ids.forEach((id) => set(id, '—'));

      // Format a value with an SI prefix (e.g. 4700 -> "4.7 kΩ").
      const si = (v: number, unit: string): string => {
        if (!isFinite(v)) return '—';
        if (v === 0) return '0 ' + unit;
        const neg = v < 0;
        let a = Math.abs(v);
        const table: [number, string][] = [
          [1e9, 'G'], [1e6, 'M'], [1e3, 'k'], [1, ''],
          [1e-3, 'm'], [1e-6, 'µ'], [1e-9, 'n'], [1e-12, 'p'],
        ];
        let pick = table[table.length - 1];
        for (const row of table) { if (a >= row[0]) { pick = row; break; } }
        const scaled = a / pick[0];
        const digits = scaled >= 100 ? 1 : scaled >= 10 ? 2 : 3;
        const s = parseFloat(scaled.toFixed(digits));
        return (neg ? '-' : '') + s + ' ' + pick[1] + unit;
      };
      const note_ok = () => note && (note.textContent = 'Results update as you type.');
      const note_msg = (m: string) => note && (note.textContent = m);

      const E12 = [10, 12, 15, 18, 22, 27, 33, 39, 47, 56, 68, 82];
      const nearestE12 = (r: number): number => {
        if (!(r > 0)) return NaN;
        const dec = Math.floor(Math.log10(r));
        let best = NaN, bestD = Infinity;
        for (let d = dec - 1; d <= dec + 1; d++) {
          for (const b of E12) {
            const c = b * Math.pow(10, d);
            const dd = Math.abs(Math.log10(c) - Math.log10(r));
            if (dd < bestD) { bestD = dd; best = c; }
          }
        }
        return best;
      };

      function compute() {
        switch (tool) {
          case 'ohms-law-calculator': {
            let V = num('V'), I = num('I'), R = num('R'), P = num('P');
            const known = [['V', V], ['I', I], ['R', R], ['P', P]].filter((k) => !isNaN(k[1] as number));
            if (known.length < 2) { dash('oV', 'oI', 'oR', 'oP'); note_msg('Enter any two values.'); return; }
            if (known.length > 2) { dash('oV', 'oI', 'oR', 'oP'); note_msg('Too many values — clear all but two.'); return; }
            const has = (x: number) => !isNaN(x);
            if (has(V) && has(I)) { R = V / I; P = V * I; }
            else if (has(V) && has(R)) { I = V / R; P = (V * V) / R; }
            else if (has(V) && has(P)) { I = P / V; R = (V * V) / P; }
            else if (has(I) && has(R)) { V = I * R; P = I * I * R; }
            else if (has(I) && has(P)) { V = P / I; R = P / (I * I); }
            else if (has(R) && has(P)) { V = Math.sqrt(P * R); I = Math.sqrt(P / R); }
            set('oV', si(V, 'V')); set('oI', si(I, 'A')); set('oR', si(R, 'Ω')); set('oP', si(P, 'W'));
            note_ok();
            break;
          }
          case 'voltage-divider-calculator': {
            const Vin = num('Vin'), R1 = num('R1') * 1e3, R2 = num('R2') * 1e3;
            if (isNaN(Vin) || isNaN(R1) || isNaN(R2) || R1 + R2 <= 0) { dash('oVout', 'oI', 'oRatio'); note_msg('Enter Vin, R1 and R2.'); return; }
            const Vout = (Vin * R2) / (R1 + R2);
            const I = Vin / (R1 + R2);
            set('oVout', si(Vout, 'V'));
            set('oI', si(I, 'A'));
            set('oRatio', (R2 / (R1 + R2)).toFixed(3) + ' × Vin');
            note_ok();
            break;
          }
          case 'led-resistor-calculator': {
            const Vs = num('Vs'), Vf = num('Vf'), If = num('If') / 1000;
            if (isNaN(Vs) || isNaN(Vf) || isNaN(If) || If <= 0) { dash('oR', 'oE12', 'oIe12', 'oP'); note_msg('Enter supply, Vf and current.'); return; }
            if (Vs <= Vf) { dash('oR', 'oE12', 'oIe12', 'oP'); note_msg('Supply must exceed the LED forward voltage.'); return; }
            const R = (Vs - Vf) / If;
            const e12 = nearestE12(R);
            const Ie12 = (Vs - Vf) / e12;
            const P = (Vs - Vf) * If;
            set('oR', si(R, 'Ω'));
            set('oE12', si(e12, 'Ω'));
            set('oIe12', si(Ie12, 'A'));
            set('oP', si(P, 'W'));
            note_ok();
            break;
          }
          case 'rc-time-constant': {
            const R = num('R') * 1e3, C = num('C') * 1e-6;
            if (isNaN(R) || isNaN(C) || R <= 0 || C <= 0) { dash('oTau', 'oT63', 'oT95', 'oT99'); note_msg('Enter R and C.'); return; }
            const tau = R * C;
            set('oTau', si(tau, 's'));
            set('oT63', si(tau, 's'));
            set('oT95', si(3 * tau, 's'));
            set('oT99', si(5 * tau, 's'));
            note_ok();
            break;
          }
          case 'resistor-color-code': {
            const d1 = sel('b1'), d2 = sel('b2'), mult = sel('mult'), tol = sel('tol');
            const value = (d1 * 10 + d2) * Math.pow(10, mult);
            const delta = (value * tol) / 100;
            set('oVal', si(value, 'Ω'));
            set('oTol', '±' + tol + '%');
            set('oRange', si(value - delta, 'Ω') + ' … ' + si(value + delta, 'Ω'));
            note_ok();
            break;
          }
          case '555-timer-calculator': {
            const R1 = num('R1') * 1e3, R2 = num('R2') * 1e3, C = num('C') * 1e-6;
            if (isNaN(R1) || isNaN(R2) || isNaN(C) || R2 <= 0 || C <= 0) { dash('oFreq', 'oPeriod', 'oHigh', 'oLow', 'oDuty'); note_msg('Enter R1, R2 and C.'); return; }
            const tHigh = 0.693 * (R1 + R2) * C;
            const tLow = 0.693 * R2 * C;
            const period = tHigh + tLow;
            const freq = 1 / period;
            const duty = (R1 + R2) / (R1 + 2 * R2);
            set('oFreq', si(freq, 'Hz'));
            set('oPeriod', si(period, 's'));
            set('oHigh', si(tHigh, 's'));
            set('oLow', si(tLow, 's'));
            set('oDuty', (duty * 100).toFixed(1) + ' %');
            note_ok();
            break;
          }
        }
      }

      form.addEventListener('input', compute);
      compute();
    }
  </script>
</Layout>

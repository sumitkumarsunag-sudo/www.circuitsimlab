---
import Layout from '../../layouts/Layout.astro';
import SchematicEditor from '../../components/editor/SchematicEditor.tsx';

// Shared circuits are carried entirely in the URL fragment (#c=<payload>),
// which never reaches the server. A single static page therefore serves every
// share link; the client decodes the fragment on mount.
export function getStaticPaths() {
  return [{ params: { id: 'v' } }];
}
---

<Layout
  title="Shared circuit — CircuitSimulate"
  description="Open and edit a shared circuit in the free online CircuitSimulate simulator."
  path="/s/v"
  noindex
  bare
>
  <SchematicEditor client:only="react" />
  <noscript>
    <div class="container-page py-16 text-center">
      <h1 class="text-2xl font-semibold">JavaScript required</h1>
      <p class="mt-3 text-ink-2">This shared circuit opens in the interactive simulator, which needs JavaScript.</p>
    </div>
  </noscript>
</Layout>

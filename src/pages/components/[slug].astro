---
import Layout from '../../layouts/Layout.astro';
import { allComponents, getComponentDef } from '../../lib/components/registry.ts';
import { renderSymbolInner } from '../../lib/components/renderSymbol.ts';

export function getStaticPaths() {
  return allComponents().map((def) => ({
    params: { slug: def.kind.replace(/_/g, '-') },
    props: { kind: def.kind },
  }));
}

const { kind } = Astro.props as { kind: string };
const def = getComponentDef(kind)!;

const propRows = def.props.filter((p) => !p.advanced);
const advRows = def.props.filter((p) => p.advanced);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://circuitsimulate.com/' },
    { '@type': 'ListItem', position: 2, name: 'Components', item: 'https://circuitsimulate.com/components' },
    { '@type': 'ListItem', position: 3, name: def.name, item: `https://circuitsimulate.com/components/${kind.replace(/_/g, '-')}` },
  ],
};

function fmtDefault(v: unknown): string {
  if (typeof v === 'boolean') return v ? 'on' : 'off';
  return String(v);
}
---

<Layout
  title={`${def.name} — Symbol, Parameters & Simulation | CircuitSimulate`}
  description={`${def.description} See the ${def.name.toLowerCase()} schematic symbol, its terminals and parameters, and simulate it online for free.`}
  path={`/components/${kind.replace(/_/g, '-')}`}
  jsonLd={jsonLd}
>
  <div class="container-page py-12 md:py-16">
    <nav class="tnum text-xs text-muted" aria-label="Breadcrumb">
      <a href="/components" class="hover:text-accent">Components</a> <span class="mx-1">/</span> {def.name}
    </nav>

    <div class="mt-6 grid gap-8 md:grid-cols-[minmax(0,1fr)_18rem] md:gap-12">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">{def.name}</h1>
        <p class="mt-3 max-w-2xl text-lg text-ink-2">{def.description}</p>

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-faint">Terminals</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {def.terminals.map((t) => (
            <li class="tnum rounded border border-line bg-surface px-2.5 py-1 text-sm">{t.name}</li>
          ))}
        </ul>

        {propRows.length > 0 && (
          <>
            <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-faint">Parameters</h2>
            <table class="mt-3 w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2 pr-4 font-medium">Name</th>
                  <th class="py-2 pr-4 font-medium">Key</th>
                  <th class="py-2 font-medium">Default</th>
                </tr>
              </thead>
              <tbody>
                {propRows.map((p) => (
                  <tr class="border-b border-line/60">
                    <td class="py-2 pr-4">{p.label}</td>
                    <td class="tnum py-2 pr-4 text-muted">{p.key}</td>
                    <td class="tnum py-2">{fmtDefault(def.defaults[p.key])}{p.unit ?? ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {advRows.length > 0 && (
              <p class="mt-3 text-xs text-muted">Plus {advRows.length} advanced parameter{advRows.length > 1 ? 's' : ''} available in the properties panel.</p>
            )}
          </>
        )}
      </div>

      <aside class="md:pt-2">
        <div class="rounded-lg border border-line bg-paper p-6">
          <svg viewBox="-60 -50 120 100" class="h-32 w-full">
            <g set:html={renderSymbolInner(def.symbol, { stroke: 'var(--color-ink)', strokeWidth: 2 })} />
          </svg>
          <p class="mt-2 text-center text-xs text-muted">Schematic symbol · ref {def.ref}</p>
        </div>
        <a href="/simulator" class="btn btn-primary mt-4 w-full justify-center">Open in simulator</a>
        <a href="/components" class="btn btn-ghost mt-2 w-full justify-center">All components</a>
      </aside>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, componentsByCategory } from '../../lib/components/registry.ts';
import { renderSymbolInner } from '../../lib/components/renderSymbol.ts';

const byCat = componentsByCategory();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://circuitsimulate.com/' },
    { '@type': 'ListItem', position: 2, name: 'Components', item: 'https://circuitsimulate.com/components' },
  ],
};
---

<Layout
  title="Component Library — Every Part You Can Simulate | CircuitSimulate"
  description="Resistors, capacitors, sources, diodes, LEDs, transistors and measurement tools — the full component set of the CircuitSimulate simulator, with symbols, terminals and parameters."
  path="/components"
  jsonLd={jsonLd}
>
  <div class="container-page py-12 md:py-16">
    <p class="tnum text-xs uppercase tracking-[0.2em] text-accent">Component library</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">Parts you can drop on the canvas</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      Every symbol below is a real, simulatable component. Click one to see its terminals, parameters
      and the physics the solver uses for it — then open it straight in the simulator.
    </p>

    {CATEGORIES.map((cat) => (
      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-faint">{cat.label}</h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {(byCat[cat.id] ?? []).map((def) => (
            <a
              href={`/components/${def.kind.replace(/_/g, '-')}`}
              class="group rounded-md border border-line bg-paper p-4 transition-colors hover:border-accent"
            >
              <svg viewBox="-50 -40 100 80" class="h-20 w-full">
                <g set:html={renderSymbolInner(def.symbol, { stroke: 'var(--color-ink)', strokeWidth: 2 })} />
              </svg>
              <div class="mt-2 flex items-baseline justify-between">
                <span class="text-sm font-medium group-hover:text-accent">{def.name}</span>
                <span class="tnum text-xs text-muted">{def.ref}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms of Service — CircuitSimulate"
  description="The terms for using CircuitSimulate: a free simulator provided as-is for education and design exploration, not a substitute for validating real hardware."
  path="/terms"
>
  <section class="container-page py-12 md:py-16">
    <div class="doc max-w-3xl">
      <p class="tnum text-xs uppercase tracking-[0.2em] text-accent">Legal</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">Terms of Service</h1>
      <p class="tnum mt-2 text-sm text-muted">Last updated: 25 August 2026</p>


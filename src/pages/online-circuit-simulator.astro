---
import Layout from '../layouts/Layout.astro';

const features = [
  'Draw schematics by dragging parts onto a snapping grid and clicking terminal to terminal to wire them.',
  'Run a real DC operating point, a transient sweep over time, or an AC frequency sweep — the same modified nodal analysis SPICE uses.',
  'Watch current animate along the wires it actually flows through, with nodes coloured by their solved voltage.',
  'Probe the circuit with a two-channel oscilloscope and a multimeter reading real volts and amps.',
  'Everything runs in your browser tab — the solver lives in a Web Worker, so the interface stays responsive.',
];

const faqs = [
  {
    q: 'Is the online circuit simulator really free?',
    a: 'Yes. Every analysis — DC, transient and AC — is free with no account and no install. Your circuit stays in your browser unless you choose to share it with a link.',
  },
  {
    q: 'Do I need to download or sign up for anything?',
    a: 'No. Open the page and start building. After the first visit the app is cached, so it keeps working even with a flaky connection.',
  },
  {
    q: 'Is this a real simulator or just an animation?',
    a: 'It is a real solver. A modified-nodal-analysis engine computes node voltages and branch currents, and the on-screen animation is driven by those solved currents — not a scripted loop.',
  },
  {
    q: 'What components can I use?',
    a: 'Resistors, capacitors, inductors, diodes, LEDs, DC and AC sources, batteries, ground, and measurement probes. Browse the full set in the component library.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'CircuitSimulate — Online Circuit Simulator',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'A free online circuit simulator with real DC, transient and AC analysis, a drag-and-drop schematic editor, and live current-flow animation — all in the browser.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="Online circuit simulator — build and simulate in your browser"
  description="A free online circuit simulator with real DC, transient and AC analysis. Draw a schematic, press run, and watch current flow — no install, no sign-up, all in the browser."
  path="/online-circuit-simulator"
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute inset-0 grid-paper grid-paper-fade opacity-60" aria-hidden="true"></div>
    <div class="container-page relative py-16 md:py-24">
      <p class="tnum text-xs uppercase tracking-[0.2em] text-accent">Online circuit simulator</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight md:text-6xl">
        Simulate circuits online, right in your browser.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink-2">
        Draw a schematic, press run, and watch real current move through it. No install, no sign-up,
        nothing to configure — just an accurate electronics lab that lives in a browser tab.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/simulator" class="btn btn-primary text-base">Open the simulator</a>
        <a href="/examples" class="btn btn-ghost text-base">Browse example circuits</a>
      </div>
    </div>
  </section>

  <section class="container-page py-16 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">What you can do</h2>
    <ul class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {features.map((f) => (
        <li class="border-t border-line pt-4 text-ink-2">{f}</li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap gap-4 text-sm">
      <a href="/components" class="prose-link">See every component →</a>
      <a href="/examples/ohms-law" class="prose-link">Start with Ohm's law →</a>
      <a href="/tools" class="prose-link">Handy calculators →</a>
    </div>
  </section>

  <section class="border-y border-line bg-surface">
    <div class="container-page py-14 md:py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Questions</h2>
      <dl class="mt-8 max-w-3xl divide-y divide-line">
        {faqs.map((f) => (
          <div class="py-5">
            <dt class="font-semibold text-ink">{f.q}</dt>
            <dd class="mt-2 text-ink-2">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="container-page py-16 text-center md:py-20">
    <h2 class="text-3xl font-semibold tracking-tight">Open a blank canvas.</h2>
    <p class="mx-auto mt-3 max-w-md text-ink-2">Free, browser-based, and yours to keep private.</p>
    <a href="/simulator" class="btn btn-primary mt-6 text-base">Open the simulator</a>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';

const steps = [
  ['Place', 'Drag resistors, capacitors, inductors, diodes, LEDs and sources onto a snapping grid.'],
  ['Wire', 'Click one terminal, then another — connections route orthogonally and snap to pins.'],
  ['Run', 'Choose DC, transient or AC. The solver runs in a background worker and returns real values.'],
  ['Measure', 'Colour-coded nodes, animated current, an oscilloscope and a multimeter show what happened.'],
];

const faqs = [
  {
    q: 'What is an electronics simulator?',
    a: 'It is software that models how a circuit behaves before you build it. This one solves the circuit equations numerically, so you can predict voltages, currents and waveforms and catch mistakes on screen instead of on the bench.',
  },
  {
    q: 'Can I learn electronics with it?',
    a: 'That is the point. Start from a worked example, change a value, and watch the result move. Because the numbers are solved rather than scripted, the intuition you build transfers to real hardware.',
  },
  {
    q: 'What kinds of analysis does it run?',
    a: 'DC operating point for steady-state voltages and currents, transient for behaviour over time, and AC for frequency response — the three workhorses of everyday circuit work.',
  },
  {
    q: 'Does it run on a Chromebook or tablet?',
    a: 'Yes. It is a web app with the solver in a Web Worker, so anything with a modern browser can run it. No native install is required.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'CircuitSimLab — Electronics Simulator',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'A free browser-based electronics simulator with real DC, transient and AC analysis, live current-flow animation and built-in scope and meter.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="Electronics simulator — model circuits before you build them"
  description="A free electronics simulator in your browser. Model resistors, capacitors, inductors, diodes and sources with real DC, transient and AC analysis. See current flow and read a scope."
  path="/electronics-simulator"
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute inset-0 grid-paper grid-paper-fade opacity-60" aria-hidden="true"></div>
    <div class="container-page relative py-16 md:py-24">
      <p class="tnum text-xs uppercase tracking-[0.2em] text-accent">Electronics simulator</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight md:text-6xl">
        Model electronics before you touch a soldering iron.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink-2">
        Build a circuit on screen, run the analysis, and understand exactly how it behaves — the
        voltages, the currents, and the waveforms. A bench you can carry in a browser tab.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/simulator" class="btn btn-primary text-base">Open the simulator</a>
        <a href="/learn" class="btn btn-ghost text-base">Learn the fundamentals</a>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-surface">
    <div class="container-page py-14 md:py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">From blank canvas to solved circuit in four steps</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map(([t, d], i) => (
          <li class="rounded-md border border-line bg-paper p-5">
            <span class="tnum text-sm text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-semibold">{t}</h3>
            <p class="mt-1 text-sm text-ink-2">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-page py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Built to teach, not just to draw</h2>
        <p class="mt-3 text-ink-2">
          Every value on screen is solved by the analysis engine, so poking at a circuit gives you
          honest feedback. Double a resistor and the current really halves; charge a capacitor and the
          scope really traces the exponential.
        </p>
      </div>
      <ul class="space-y-3 text-sm text-ink-2">
        <li class="border-t border-line pt-3"><a href="/examples/series-resistors" class="prose-link">Series and parallel resistor networks →</a></li>
        <li class="border-t border-line pt-3"><a href="/examples/rc-charging" class="prose-link">RC charging on the oscilloscope →</a></li>
        <li class="border-t border-line pt-3"><a href="/tools/ohms-law-calculator" class="prose-link">Ohm's law calculator →</a></li>
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-page py-14 md:py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Questions</h2>
      <dl class="mt-8 max-w-3xl divide-y divide-line">
        {faqs.map((f) => (
          <div class="py-5">
            <dt class="font-semibold text-ink">{f.q}</dt>
            <dd class="mt-2 text-ink-2">{f.a}</dd>
          </div>
        ))}
      </dl>
      <a href="/simulator" class="btn btn-primary mt-10 text-base">Open the simulator</a>
    </div>
  </section>
</Layout>

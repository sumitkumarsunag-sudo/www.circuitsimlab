---
import Layout from '../../layouts/Layout.astro';
import { LEARN, getArticle } from '../../lib/content/learn.ts';
import { getExample } from '../../lib/content/examples.ts';

export function getStaticPaths() {
  return LEARN.map((a) => ({ params: { slug: a.slug }, props: { slug: a.slug } }));
}

const { slug } = Astro.props as { slug: string };
const article = getArticle(slug)!;

// Resolve related articles that actually exist.
const related = (article.related ?? [])
  .map((s) => getArticle(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// Look up the linked example's title for the button label (no build() call).
const example = article.exampleSlug ? getExample(article.exampleSlug) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.title,
  description: article.summary,
  about: 'Electronics and circuit fundamentals',
};
---

<Layout
  title={`${article.title} — Learn Electronics | CircuitSimulate`}
  description={article.summary}
  path={`/learn/${article.slug}`}
  jsonLd={jsonLd}
>
  <div class="container-page py-12 md:py-16">
    <nav class="tnum text-xs text-muted" aria-label="Breadcrumb">
      <a href="/learn" class="hover:text-accent">Learn</a> <span class="mx-1">/</span> {article.section}
    </nav>

    <header class="mt-4 max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">{article.title}</h1>
      <p class="mt-3 text-lg text-ink-2">{article.summary}</p>
      <p class="tnum mt-3 text-xs text-muted">{article.readingMinutes} min read · {article.section}</p>
    </header>

    {example && (
      <a href={`/examples/${example.slug}`} class="btn btn-primary mt-6">
        Open the {example.title} example →
      </a>
    )}

    <article class="doc mt-10 max-w-3xl">
      {article.body.map((block) => {
        if (block.type === 'h2') return <h2>{block.text}</h2>;
        if (block.type === 'p') return <p>{block.text}</p>;
        if (block.type === 'list') return <ul>{block.items.map((it) => <li>{it}</li>)}</ul>;
        if (block.type === 'formula')
          return <p class="tnum rounded bg-surface-2 px-3 py-2 text-accent">{block.text}</p>;
        if (block.type === 'tip')
          return (
            <div class="my-4 rounded border-l-4 border-accent bg-accent-soft px-4 py-3 text-sm text-ink-2">
              <span class="font-semibold text-ink">Tip. </span>{block.text}
            </div>
          );
        return null;
      })}
    </article>

    {related.length > 0 && (
      <section class="mt-14 max-w-3xl border-t border-line pt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-faint">Related reading</h2>
        <ul class="mt-4 space-y-3">
          {related.map((r) => (
            <li>
              <a href={`/learn/${r.slug}`} class="group flex items-baseline justify-between gap-3">
                <span class="font-medium group-hover:text-accent">{r.title}</span>
                <span class="tnum shrink-0 text-xs text-muted">{r.readingMinutes} min</span>
              </a>
              <p class="mt-0.5 text-sm text-ink-2">{r.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-14 max-w-3xl rounded-lg border border-line bg-surface p-6 md:p-8">
      <h2 class="text-lg font-semibold tracking-tight">Try it yourself</h2>
      <p class="mt-2 text-sm text-ink-2">
        Reading only gets you so far. Open the editor, build the circuit, and change a value to see the
        idea move.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/simulator" class="btn btn-primary">Open the simulator →</a>
        <a href="/learn" class="btn btn-ghost">More guides</a>
      </div>
    </div>
  </div>
</Layout>

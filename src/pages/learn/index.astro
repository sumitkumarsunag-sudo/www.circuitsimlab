---
import Layout from '../../layouts/Layout.astro';
import { LEARN } from '../../lib/content/learn.ts';

// Group by section, preserving first-seen order.
const sections: string[] = [];
for (const a of LEARN) if (!sections.includes(a.section)) sections.push(a.section);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: LEARN.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.title,
    url: `https://circuitsimulate.com/learn/${a.slug}`,
  })),
};
---

<Layout
  title="Learn Electronics — Guides & Fundamentals | CircuitSimulate"
  description="Clear, accurate guides to the fundamentals of circuits — Ohm's law, voltage dividers, capacitors, diodes and the analysis types. Each one links to a circuit you can open and run."
  path="/learn"
  jsonLd={jsonLd}
>
  <div class="container-page py-12 md:py-16">
    <p class="tnum text-xs uppercase tracking-[0.2em] text-accent">Learn</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">Electronics, from first principles</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      Short, honest explanations of the ideas behind every circuit — the formulas, the intuition and the
      gotchas. Where a topic has a matching example, you can open it live in the simulator and watch the
      numbers for yourself.
    </p>

    {sections.map((section) => (
      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-faint">{section}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {LEARN.filter((a) => a.section === section).map((a) => (
            <a
              href={`/learn/${a.slug}`}
              class="group flex flex-col rounded-lg border border-line bg-paper p-5 transition-colors hover:border-accent"
            >
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-semibold tracking-tight group-hover:text-accent">{a.title}</h3>
                <span class="tnum shrink-0 text-xs text-muted">{a.readingMinutes} min</span>
              </div>
              <p class="mt-2 flex-1 text-sm text-ink-2">{a.summary}</p>
              <span class="mt-3 text-sm text-accent">Read →</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="mt-16 rounded-lg border border-line bg-surface p-6 md:p-8">
      <h2 class="text-lg font-semibold tracking-tight">Ready to build one?</h2>
      <p class="mt-2 max-w-2xl text-sm text-ink-2">
        The fastest way to understand a circuit is to change it and watch what happens. Open the editor and
        wire something up.
      </p>
      <a href="/simulator" class="btn btn-primary mt-4">Open the simulator →</a>
    </div>
  </div>
</Layout>
